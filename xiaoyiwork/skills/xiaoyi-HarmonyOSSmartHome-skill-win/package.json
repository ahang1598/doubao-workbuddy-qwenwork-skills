  "license": "ISC",
  "dependencies": {
    "commander": "13.1.0",
    "redis": "6.1.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "nodemon": "3.1.14",
    "prettier": "3.5.2",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
