{
  "version": 3,
  "usage": "先由当前品类 Spec 取得 ref_key，再筛选 CSS 与 SVG 候选。映射只表示可进入候选集，不表示必须应用；最终由 最终 HTML 按自然语言 Design Brief 的对象、作用和参考继承范围绑定真实消费者。",
  "naming_contract": {
    "category_ref_key": "category_refs 的键是品类 Spec、Visual System、CSS 与 SVG 共用的稳定名称",
    "template_id": "CSS catalog.entries[].id 与 SVG catalog.entries[].id 是唯一机器名，不使用展示标题做关联键",
    "display_name": "各 catalog entries[].name 是给 Agent 和检查输出使用的唯一中文展示名",
    "resolution": "category_ref_key → CSS default_ref_keys/entry_overrides 或 SVG ref_keys → catalog id + name + implementation path",
    "binding_meaning": "命中只进入候选集；最终采用项必须在 最终 HTML 绑定真实消费者、正文依赖和覆盖值"
  },
