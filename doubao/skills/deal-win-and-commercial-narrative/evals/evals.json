    {
      "id": "E15_route_sales_call_coaching",
      "kind": "scenario",
      "name": "销售人员通话趋势转辅导Skill",
      "input": "比较王销售最近三个月与同侪的发现会表现，判断哪些行为进步或退化，并给两周训练动作；不针对某个具体商机。",
