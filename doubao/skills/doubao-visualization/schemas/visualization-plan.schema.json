{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doubao Visualize Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["should_visualize", "goals", "assets", "user_image_policy", "presentations", "required_files", "required_files_loaded", "facts_status", "reason"],
  "properties": {
    "should_visualize": {"type": "boolean"},
    "goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["data_analysis", "knowledge_explanation", "visual_evidence", "dynamic_exploration"]
      }
    },
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["structured_data", "user_image", "text_context", "verified_sources", "none"]
      }
    },
    "user_image_policy": {
      "enum": ["not_applicable", "preserve", "reference"]
    },
    "presentations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": ["echarts", "static_image_overlay", "interactive_html", "generated_illustration", "text_only"]
      }
    },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(references|examples)/[a-z0-9-]+\\.md$"
      }
    },
    "required_files_loaded": {"type": "boolean"},
    "facts_status": {
      "enum": ["user_provided", "verified", "example_declared", "insufficient"]
    },
    "reason": {"type": "string", "minLength": 1, "maxLength": 240}
  },
  "allOf": [
    {
      "if": {"properties": {"assets": {"contains": {"const": "user_image"}}}, "required": ["assets"]},
      "then": {"properties": {"user_image_policy": {"enum": ["preserve", "reference"]}}},
      "else": {"properties": {"user_image_policy": {"const": "not_applicable"}}}
    },
    {
      "if": {"properties": {"presentations": {"contains": {"const": "static_image_overlay"}}}, "required": ["presentations"]},
      "then": {
        "properties": {
          "assets": {"contains": {"const": "user_image"}},
          "user_image_policy": {"const": "preserve"}
        }
      }
    },
    {
      "if": {"properties": {"presentations": {"contains": {"const": "text_only"}}}, "required": ["presentations"]},
      "then": {"properties": {"presentations": {"maxItems": 1}}}
    }
  ]
}
