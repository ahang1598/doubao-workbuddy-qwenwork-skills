{
  "source": "risk-library/trap-detection 合并规则集",
  "description": "一套规则库，按执行主体分三组：A确定性(脚本)/B方向敏感(过立场闸门)/C完备性(存在性)。类型专属规则条件加载后打组标签同池排序。",
  "clusters": {
    "A": "确定性检查：verify_all.py 一次执行，LLM 只读 verify_results.json，禁止心算替代。",
    "B": "方向敏感检查：每条候选批注必须先过 §一·1.2 立场闸门；当前受益方=我方→直接丢弃并留痕。",
    "C": "完备性/规范检查：只查『有没有』，不过闸门。"
  },
  "deleted": [
    "F-10",
    "RL-16",
    "RL-22",
    "RL-25",
    "S-23"
  ],
  "delete_reasons": {
    "RL-16": "与 RL-37 重复",
    "RL-22": "主观、易噪音",
    "RL-25": "标删除",
    "F-10": "纯格式洁癖，低价值",
    "S-23": "商业裁量/低概率，噪音源"
  },
