{
  "version": 12,
  "case_type": "event-impact-analysis",
  "default_mode": "auto",
  "modes": {
    "传导模式": {
      "required_payload": [
        "event_status",
        "baseline",
        "channels",
        "exposures"
      ],
      "required_sections": []
    },
    "路径模式": {
      "required_payload": [
        "event_status",
        "baseline",
        "scenarios"
      ],
      "required_sections": []
    },
    "快速判断": {
      "required_payload": [
        "event_status",
        "channels"
      ],
      "required_sections": []
    }
  },
  "capabilities": {
    "can_analyze_event": [
      "payload.event_status",
      "payload.baseline",
      "payload.channels"
    ],
    "can_quantify_event": [
      "payload.event_status",
      "payload.scenarios"
    ]
  },
  "privacy_scan": false,
  "banned_patterns": [],
  "direct_response": {
    "forbid_internal_markers": true,
    "forbid_unsupported_quantification": true,
    "partial_answer_when_some_inputs_missing": true
  },
  "success_contract": {
    "传导模式": {
      "success": "解释事件改变的变量、目标主体的实际暴露及经营或市场后果；只量化有可靠输入的部分。"
    },
    "路径模式": {
      "success": "说明关键条件、时间节点与通过或失败的结果；输入不足时保留路径判断，不计算收益。"
    },
    "快速判断": {
      "success": "直接回答事件状态、最重要的影响路径和会改变判断的条件。"
    }
  },
  "expected_artifacts": [],
  "future_adjacent_skills": [
    "event-path-modeling",
    "catalyst-calendar",
    "macro-strategy",
    "earnings-event-analysis",
    "regulatory-timeline-analysis"
  ],
  "future_adjacent_skills_are_unshipped": true,
  "shipped_adjacent_skills": [
    "company-analysis",
    "event-impact-analysis",
    "investment-opportunity-screening",
    "private-market-project-evaluation",
    "wealth-planning"
  ],
  "no_routing_to_unshipped_skills": true,
  "out_of_scope_degrades_in_skill_not_stop": true,
  "rubric_id": "event-impact-analysis-v1",
  "loading_profile": "config/loading-profile.json",
  "degraded_artifacts": "references/degraded-artifacts.md",
  "deterministic_tool": "scripts/event_claim_engine.py",
  "tool_contract": "references/deterministic-tool-contract.md",
  "delivery_tiers": {
    "direct": {
      "format": "direct_answer"
    },
    "brief": {
      "format": "focused_impact_analysis"
    },
    "full": {
      "format": "one_main_markdown_report"
    }
  },
  "provider_safety_ceiling": {
    "failure_statuses": [
      "incomplete"
    ],
    "failure_finish_reasons": [
      "length",
      "max_tokens"
    ],
    "target_overrun_is_failure": false
  },
  "intake_preflight": "scripts/intake_preflight.py",
  "intake_required_inputs": {
    "传导模式": [
      "inputs.event"
    ],
    "路径模式": [
      "inputs.event"
    ],
    "快速判断": [
      "inputs.event"
    ]
  },
  "conditional_tool_policy": "普通问答不运行事实台账、质量门禁或计算脚本；只有用户要求结构化复核或需要重复计算且输入齐全时，才使用相应工具。",
  "search_router": "scripts/search_router.py",
  "seed_finance_search": {
    "reference": "references/seed-finance-search-routing.md",
    "schema_policy": "use_host_actual_schema_do_not_invent_parameters",
    "allowed_scope": [
      "market_price",
      "curve",
      "volume",
      "consensus",
      "company_financial_exposure",
      "institutional_view",
      "priced_in_baseline"
    ],
    "library_result_is_primary": false,
    "missing_pre_event_baseline": {
      "can_assess_priced_in": false,
      "degradation_scope": "priced_in_only"
    }
  },
  "search_contract": {
    "routing_policy": "query_only_for_current_decision",
    "fixed_call_budget": false,
    "mandatory_claim_ledger": false,
    "reader_facing_output_contract": {
      "inline_machine_source_tags": false,
      "fixed_summary_line_count": false,
      "fixed_section_titles": false,
      "mandatory_tier_table": false,
      "mandatory_assumption_card": false,
      "key_numbers_traceable": true,
      "priced_in_requires_comparable_pre_event_baseline": true
    }
  }
}
