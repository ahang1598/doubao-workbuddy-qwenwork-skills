        }
      ]
    },
    "路径模式": {
      "required_payload": [
        "event_status",
        "baseline",
        "scenarios"
      ],
      "required_sections": [
        {
          "aliases": [
            "事件状态与市场基线"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "相对预期的新变化"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "Priced in 与待验证事项"
          ],
          "min_chars": 20,
          "fact_binding": true
        },
        {
          "aliases": [
            "Base/Upside/Downside 情景"
