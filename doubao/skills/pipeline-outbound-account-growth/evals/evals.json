{
  "skill": "pipeline-outbound-account-growth",
  "version": "V7.2",
  "machine_checks": {
    "internal_only": true,
    "required_dimensions": ["artifact_state", "delivery_tier", "route", "capability", "claim_ledger", "permission"],
    "allowed_states": ["ready", "degraded", "intake_required", "confirmation_required", "routed", "stopped"],
    "case_defaults": {"expected_state": "degraded"},
    "derivation_rules": [
      {"when": "missing_blocking_intake", "expected_state": "intake_required"},
      {"when": "unconfirmed_side_effect", "expected_state": "confirmation_required"},
      {"when": "adjacent_primary_task", "expected_state": "routed"}
    ]
  },
  "user_visible_checks": {
    "required_business_sections": ["结论或建议", "核心主工件", "证据或来源", "风险或待确认", "下一步"],
    "forbidden_tokens": ["artifact_state", "delivery_tier", "selected_skill", "route_status", "permission_status", "blocked_slots", "claim_gate", "artifact_gate", "permission_gate", "crm_truth", "schema", "payload", "sha256", "Hard Gate", "主张台账", ".full.json", ".compact.json", "Traceback", "ModuleNotFoundError", "tool_call"]
  },
  "evals": [
    {
      "id": "E01_positive_lead_call_list",
      "kind": "scenario",
      "name": "完整线索生成分层外呼清单",
      "prompt": "这是本周线索表（含公司、行业、规模、近7天打开定价页次数、是否ICP内）：请评分并给我今日外呼清单和话术要点。周期本周，团队偏SME软件。",
      "setup": {
        "inputs_present": ["leads_or_accounts", "period_and_scope", "task_focus"],
        "signals": true
      },
      "expected_route": "pipeline-outbound-account-growth",
      "expected_mode": "lead_call_list",
      "expected_artifact_state": "ready",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "分层",
        "话术要点",
        "Hot",
        "下一步"
      ],
      "must_not_include": [
        "已发送邮件",
        "已写回CRM",
        "保证成交"
      ],
      "expected_permission_status": "none_required"
    },
    {
      "id": "E02_positive_signal_sequence",
      "kind": "scenario",
      "name": "招聘与技术替换信号生成序列",
      "prompt": "账号A在招销售运营且官网出现竞品替换RFP字样，请设计信号驱动拓客序列，不要真的发信。",
      "expected_route": "pipeline-outbound-account-growth",
      "expected_mode": "signal_sequence",
      "expected_artifact_state": "ready",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "序列",
        "退出条件",
        "文案草稿"
      ],
      "must_not_include": [
        "已代发",
        "广告预算配比"
      ],
      "expected_permission_status": "none_required"
    },
    {
      "id": "E03_positive_pipeline_health",
      "kind": "scenario",
      "name": "有管道与配额做健康与情景预测",
      "prompt": "附上各阶段金额与数量、本季配额。请做管道健康和本季收入情景，不要给假赢单率。",
      "setup": {
        "pipeline": true,
        "quota": true,
        "history_conversion": false
      },
      "expected_route": "pipeline-outbound-account-growth",
      "expected_mode": "pipeline_health",
      "expected_artifact_state": "degraded",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "情景",
        "待确认",
        "局限",
        "老化"
      ],
      "must_not_include": [
        "必将完成配额",
        "精准赢单率0."
      ],
      "expected_permission_status": "none_required"
    },
    {
      "id": "E04_positive_expand_retain",
      "kind": "scenario",
      "name": "续约窗与使用数据扩建保有",
      "prompt": "大客户B合同90天后续约，使用模块2/5，反馈称实施慢。请给扩建保有计划与QBR框架。",
      "expected_route": "pipeline-outbound-account-growth",
      "expected_mode": "account_expand_retain",
      "expected_artifact_state": "ready",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "QBR",
        "风险",
        "扩建",
        "下一步"
      ],
      "must_not_include": [
        "客诉已结案",
        "已自动变更合同"
      ],
      "expected_permission_status": "none_required"
