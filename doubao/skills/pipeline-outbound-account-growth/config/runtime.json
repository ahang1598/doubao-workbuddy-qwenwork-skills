  },
  "capability_gates": {
    "internal_only": true,
    "status_enum": [
      "allowed",
      "missing",
      "blocked"
    ],
    "slots": [
      "can_research_account",
      "can_enrich_identity",
      "can_monitor_signals",
      "can_prioritize_accounts",
      "can_forecast_current",
      "can_forecast_movement",
      "can_draft_outreach",
      "can_send_outreach",
      "can_write_crm",
      "can_expand_retain"
    ],
    "blocked_slots_are_local": true
  },
  "truth_priority": {
    "crm_owned": [
      "account_universe",
      "identity",
      "owner",
      "customer_status",
      "opportunity",
      "stage",
      "amount",
      "forecast_category",
      "close_date",
      "activity"
    ],
