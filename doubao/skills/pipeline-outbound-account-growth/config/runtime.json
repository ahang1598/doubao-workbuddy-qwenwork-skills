      "provider_native_external_fields"
    ],
    "supporting_only": [
      "meeting",
      "email",
      "message",
      "file",
      "public_research"
    ]
  },
  "claim_ledger": {
    "required_fields": [
      "claim_id",
      "claim",
      "claim_type",
      "critical",
      "object_id",
      "period",
      "unit",
      "source_ids",
      "source_tier",
      "confidence",
      "conflict_state"
    ],
    "claim_types": [
      "fact",
      "calculation",
      "inference",
      "assumption",
      "management_claim",
      "unknown"
    ],
    "unknown_must_not_rank": true,
    "set_conservation_required": true
  },
  "deterministic_tool": {
    "name": "pipeline_forecast_engine",
    "path": "scripts/pipeline_forecast.py",
    "input_schema": "schemas/pipeline-forecast.schema.json",
    "operations": ["calculate", "gate", "finalize", "lint", "prioritize", "channel-plan", "funnel", "events"],
    "contract": "constraint_first_dedupe_stage_currency_amount_conservation_forecast_capacity_budget_funnel_cutoff",
    "tool_result_must_not_be_rewritten": true,
    "prompt_only_fallback": "apply_the_same_explicit_formulas_and_disclose_unautomated_checks_without_claiming_tool_execution",
    "probability_source": "user_or_organization_calibrated_only",
    "movement_requires_snapshot": true
  },
  "tool_contract": {
    "null_policy": "preserve_unknown",
    "forbid_default_industry_metrics": true,
    "require_formula_inputs_units_period_tolerance_errors": true,
    "constraint_order": ["account_identity", "owner", "suppression", "active_opportunity", "channel_capacity", "signal", "action"],
    "proposed_action_is_not_execution": true,
    "funnel_denominator_compatibility_required": true,
    "sample_must_not_be_extrapolated": true
  },
  "compact_tool_output": [
    "core_results",
    "exceptions",
    "unknowns",
    "hard_gates",
    "source_index",
    "full_artifact_path"
  ],
  "expected_artifacts": [
    "pipeline_growth_operating_pack",
    "claim_ledger",
    "forecast_full_json",
    "forecast_compact_json",
    "forecast_final_json"
  ],
  "deliverable_validator": "scripts/pipeline_forecast.py",
  "deliverable_validator_operation": "lint",
  "claim_artifact_permission_gate": {
    "path": "scripts/pipeline_forecast.py",
    "operation": "gate",
    "claim_schema": "schemas/pipeline-forecast.schema.json#/$defs/claim",
    "required_artifacts": ["forecast_full_json", "forecast_compact_json", "forecast_final_json", "claim_ledger"],
    "caller_may_override_required_artifacts": false,
    "receipt_fields": ["artifact_name", "path", "expected_sha256"],
    "verify": ["file_exists", "sha256_matches_receipt", "artifact_name", "artifact_state_consistency", "counts_consistency", "required_artifact_set_consistency"]
  },
  "finalizer": {
    "mode": "source_locked",
    "path": "scripts/pipeline_forecast.py",
    "operation": "finalize",
    "max_runs": 1,
    "forbid": [
      "new_search",
      "new_source_id",
      "new_object",
      "new_threshold",
      "new_probability",
      "new_number"
    ]
  },
  "user_visible_contract": {
    "validator": "scripts/pipeline_forecast.py",
    "operation": "lint",
    "minimum_sections": ["business_decision", "primary_artifact", "evidence_sources", "risks_and_unknowns", "next_actions"],
    "forbidden_tokens": ["artifact_state", "delivery_tier", "selected_skill", "route_status", "permission_status", "blocked_slots", "claim_gate", "artifact_gate", "permission_gate", "crm_truth", "schema", "payload", "sha256", "Hard Gate", "主张台账", ".full.json", ".compact.json", "Traceback", "ModuleNotFoundError", "tool_call"],
    "completion_evidence_required": true,
    "external_artifacts_are_supplementary": true,
    "partial_failure_policy": "deliver_supported_sections_then_list_missing_scope_and_business_impact"
  },
  "privacy_scan": {
    "enabled": true,
    "minimize_pii": true,
    "forbid_guessed_contact_details": true
  },
  "side_effect_policy": {
    "draft_is_not_send": true,
    "require_preview_permission_confirmation": true,
    "execution_default": "not_executed",
    "idempotency_key_fields": [
      "action_type",
      "object_id",
      "payload_hash",
      "requested_at_date"
    ],
    "deny": [
      "delete",
      "pay",
      "deploy"
    ]
  },
  "connector_boundary": {
    "connectors": [
      "salesforce",
      "hubspot",
      "apollo",
      "zoominfo"
    ],
    "support": [
      "answers-ask-user-input",
      "index"
    ],
    "allowed_role": "read_map_preview_confirmed_execute",
    "forbid_business_judgment": true,
    "forbid_vendor_details_in_skill": true
  },
  "success_contract": {
    "success": "required_slots_supported_and_hard_gates_pass",
    "degraded": "minimum_complete_artifact_with_local_blocked_slots",
    "stop": "unsafe_or_no_authoritative_object_set"
  },
  "loading_profile": {
    "root": "route_intake_capability_workflow_output_hard_gates",
