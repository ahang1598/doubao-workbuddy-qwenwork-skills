      "degraded",
      "intake_required",
      "confirmation_required",
      "routed",
      "stopped"
    ]
  },
  "delivery_tiers": {
    "direct": {
      "target_chars": 1800,
      "target_output_tokens": 1200,
      "required_slots": [
        "business_decision",
        "primary_artifact",
        "evidence_sources",
        "risks_and_unknowns",
        "next_actions"
      ]
    },
    "brief": {
      "target_chars": 5200,
      "target_output_tokens": 3400,
      "required_slots": [
        "business_decision",
        "primary_artifact",
        "evidence_sources",
        "risks_and_unknowns",
        "exceptions",
        "next_actions"
      ]
    },
    "full": {
      "target_chars": 11000,
      "target_output_tokens": 7000,
      "required_slots": [
        "business_scope",
        "decision_summary",
        "account_or_lead_view",
        "forecast_or_funnel",
        "interventions",
        "evidence_sources",
        "risks_and_unknowns",
        "next_actions"
      ]
    }
  },
  "provider_safety_ceiling": {
    "hard_max_output_tokens": 8000,
    "on_approach": "compress_to_minimum_complete_artifact"
  },
  "route_contract": {
    "internal_only": true,
    "required_fields": [
      "selected_skill",
      "intent",
      "route_status"
    ],
    "route_only_forbids_analysis": true,
    "adjacent": {
      "active_deal_strategy": "deal-win-and-commercial-narrative",
      "sales_rep_call_coaching": "sales-call-coaching-and-trends",
      "ad_media_buy": "marketing-media",
      "master_data": "data-governance",
      "single_complaint": "support-ticket"
    }
  },
  "intake_required_inputs": {
    "blocking": [
      "leads_or_accounts",
      "task_focus"
    ],
    "mode_blocking": {
      "pipeline_health": ["period_and_scope"],
      "movement": ["period_and_scope", "current_and_prior_snapshot"],
      "event_analysis": ["period_and_scope", "event_cutoff_definition"]
    },
    "backfillable": [
      "crm_snapshot",
      "quota",
      "icp",
      "signals",
      "renewal_usage",
      "followup_queue"
    ],
