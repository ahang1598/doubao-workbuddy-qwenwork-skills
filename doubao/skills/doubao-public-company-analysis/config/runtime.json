  "success_contract": {
    "快速判断": {
      "success": "身份、核心事实、关键财务、主要风险和数据缺口清楚，结论不超过证据。",
      "degraded": "仅将受缺口影响的结论降级；仍交付直接结论、类型驱动、同行或阻断、财务桥、降级估值、最强反方与证伪。",
      "stop": "公司身份存在歧义且无法消歧。"
    },
    "完整研究": {
      "success": "商业、竞争、财务、估值、观点、反方、风险和来源形成一致链路。",
      "degraded": "局部 capability=false 不阻断其他章节；估值缺输入时使用 degraded 模式，给出隐含假设关系与缺失输入，不输出目标价。",
      "stop": "请求实际属于筛选、一级项目、事件或财富规划。"
    },
    "聚焦分析": {
      "success": "只回答指定问题及其必要上游证据，给出反方与证伪。",
      "degraded": "缺关键数据时提出最多3个问题，并继续交付不受影响的结论及条件化判断。",
      "stop": "用户要求独立完整三表、LBO或投行级模型。"
    }
  },
