{
  "version": 13,
  "case_type": "company-analysis-seed-finance",
  "default_mode": "auto",
  "modes": {
    "快速判断": {
      "required_payload": [],
      "required_sections": []
    },
    "完整研究": {
      "required_payload": [],
      "required_sections": []
    },
    "聚焦分析": {
      "required_payload": [],
      "required_sections": []
    }
  },
  "capabilities": {
    "can_assess_business": [
      "payload.business_model",
      "payload.financial_periods"
    ],
    "can_assess_competition": [
      "payload.competition"
    ],
    "can_assess_financial_quality": [
      "payload.financial_periods",
      "payload.financial_bridge"
    ],
    "can_compare_peers": [
      "payload.competition"
    ],
    "can_value": [
      "payload.valuation_inputs"
    ],
    "can_state_investment_view": [
      "payload.thesis",
      "payload.risks"
    ]
  },
  "privacy_scan": false,
  "banned_patterns": [],
  "direct_response": {
    "forbid_internal_markers": true
  },
  "success_contract": {
    "快速判断": {
      "success": "直接回答问题，并说明关键依据与重要未知。"
    },
    "聚焦分析": {
      "success": "深入当前问题，解释它对整体判断的影响。"
    },
    "完整研究": {
      "success": "按公司实际情况形成商业模式、竞争、财务、估值和风险的连贯判断。"
    }
  },
  "expected_artifacts": [
    "report.md"
  ],
  "future_adjacent_skills": [
    "company-tearsheet",
    "comparable-company-analysis",
    "dcf-valuation-modeling",
    "three-statement-forecasting",
    "earnings-analysis"
  ],
  "future_adjacent_skills_are_unshipped": true,
  "shipped_adjacent_skills": [
    "company-analysis",
    "event-impact-analysis",
    "investment-opportunity-screening",
    "private-market-project-evaluation",
    "wealth-planning"
  ],
  "no_routing_to_unshipped_skills": true,
  "out_of_scope_degrades_in_skill_not_stop": true,
  "rubric_id": "company-analysis-v1",
  "loading_profile": "config/loading-profile.json",
  "degraded_artifacts": "references/degraded-artifacts.md",
  "deterministic_tool": "scripts/company_cashflow_bridge.py",
  "tool_contract": "references/deterministic-tool-contract.md",
  "delivery_tiers": {
    "direct": {
      "format": "direct_answer"
    },
    "brief": {
      "format": "focused_analysis"
    },
    "full": {
      "format": "one_main_markdown_report"
    }
  },
  "provider_safety_ceiling": {
    "failure_statuses": [
      "incomplete"
    ],
    "failure_finish_reasons": [
      "length",
      "max_tokens"
    ],
    "target_overrun_is_failure": false
  },
  "intake_preflight": "scripts/intake_preflight.py",
  "intake_required_inputs": {
    "快速判断": [
      "inputs.company",
      "inputs.analysis_focus"
    ],
    "完整研究": [
      "inputs.company",
      "inputs.financial_periods"
    ],
    "聚焦分析": [
      "inputs.company",
      "inputs.focus_question"
    ]
  },
  "conditional_tool_policy": "仅在问题涉及利润质量、现金转化或自由现金流时运行现金流桥接；简单估值边界或商业问题不强制运行。",
  "search_router": "scripts/search_router.py",
  "deliverable_validator": "scripts/validate_deliverable.py",
  "search_contract": {
    "routing_policy": "query_facts_needed_for_current_decision",
    "fixed_call_budget": false,
    "mandatory_claim_ledger": false,
    "single_source_policy": "identify_source_and_limit_claim_strength",
    "conflict_policy": "show_material_disagreement",
    "reader_facing_output_contract": {
      "inline_machine_source_tags": false,
      "irrelevant_details_in_main_text": false,
      "fixed_summary_line_count": false,
      "fixed_section_titles": false,
      "mandatory_peer_comparison": false,
      "mandatory_cashflow_bridge": false,
      "mandatory_valuation_section": false,
      "mandatory_falsification_count": false
    }
  }
}
