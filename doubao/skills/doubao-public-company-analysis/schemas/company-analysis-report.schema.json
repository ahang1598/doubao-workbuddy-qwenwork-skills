{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional company analysis fact record",
  "description": "Use only when a structured fact record helps the task. Ordinary answers do not require this file or any fixed number of sections, sources, peers, or signals.",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "properties": {
        "company": {"type": "string", "minLength": 1},
        "ticker": {"type": "string"},
        "exchange": {"type": "string"},
        "as_of": {"type": "string"},
        "latest_fy": {"type": "string"},
        "latest_reported_period": {"type": "string"},
        "freeze_point_checked": {"type": "boolean"}
      }
    },
    "answer": {
      "type": "object",
      "properties": {
        "core_judgment": {"type": "string"},
        "largest_uncertainty": {"type": "string"}
      }
    },
    "claims": {"type": "array"},
    "sources": {"type": "array"},
    "calculations": {"type": "array"},
    "evidence_slots": {"type": "array"},
    "company_type": {"type": "object"},
    "competition": {"type": "object"},
    "financial_quality": {"type": "object"},
    "valuation": {
      "type": "object",
      "properties": {
        "mode": {"enum": ["full", "degraded", "blocked"]},
        "as_of": {"type": "string"},
        "method": {"type": "string"},
        "market_inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string"},
              "as_of": {"type": "string"},
              "value": {},
              "source_id": {"type": "string"}
            }
          }
        }
      }
    },
    "bear_case": {"type": "object"},
    "unknowns": {"type": "array"}
  }
}
