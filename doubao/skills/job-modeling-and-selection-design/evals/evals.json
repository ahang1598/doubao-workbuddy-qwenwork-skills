      "expected_route": "job-modeling-and-selection-design",
      "expected_mode": "campus_social_selection",
      "expected_artifact_state": "ready",
      "must_ask": false,
      "must_stop": false,
      "must_include": ["可发布JD", "胜任力", "评分", "artifact_state", "Hard Gate"],
      "must_not_include": ["已代为发布", "录用决定为", "只要男性"],
      "permission_status": "none",
      "notes": "正例全套"
    },
    {
      "id": "E02",
      "kind": "scenario",
