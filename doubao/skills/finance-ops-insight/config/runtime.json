      "required_slots": [
        "answer",
        "metric_bridge",
        "exceptions",
        "unknowns",
        "actions",
        "artifact_index"
      ]
    },
    "full": {
      "target_chars": 7000,
      "target_output_tokens": 3600,
      "required_slots": [
        "executive_summary",
        "metric_bridge",
        "scenarios",
        "counter_case",
        "unknowns",
        "actions",
        "artifact_index"
      ]
    }
  },
  "provider_safety_ceiling": {
    "max_output_tokens": 6000,
    "on_risk": "complete_compact_degraded_artifact"
  },
  "route_contract": {
    "fields": [
      "selected_skill",
      "intent",
      "route_status"
    ],
    "route_only_no_analysis": true
  },
  "capability_gates": {
    "can_explain_variance": [
      "financial_data",
      "baseline",
      "period_currency"
    ],
    "can_forecast": [
      "opening_cash",
      "dated_cash_flows",
      "period_currency"
    ],
    "can_analyze_margin": [
      "revenue",
      "cost_basis"
    ],
    "can_recommend_action": [
      "metric_result",
      "user_policy_or_explicit_scenario"
    ]
  },
  "claim_ledger": {
    "required": true,
    "critical_primary_or_official": true,
    "unknown_conservation": true
  },
  "artifact_contract": {
    "full": "write_complete_json_with_schema_hash_counts",
    "compact": "core_results_exceptions_unknowns_hard_gates_sources_path"
  },
  "deterministic_tool": "scripts/business_metrics.py",
  "tool_contract": {
    "generic_schema": true,
    "preserve_unknown": true,
    "emit_formula_unit_period_assumptions": true
  },
  "compact_tool_output": "compact_summary_only",
  "deliverable_validator": "runtime/validate_deliverable.py",
