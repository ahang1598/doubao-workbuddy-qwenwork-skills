{
  "skill": "finance-ops-insight",
  "version": "V1",
  "evals": [
    {
      "id": "E01-positive-variance",
      "kind": "scenario",
      "utterance": "对比本月预算和实际收入：预算10000件×50元，实际11000件×48元，给我差异瀑布和高管简报。",
      "expected_route": "finance-ops-insight",
      "expected_mode": "variance",
      "expected_artifact_state": "ready",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "volume_effect",
        "price_effect",
        "total_variance",
        "artifact_state",
        "行动"
      ],
      "must_not_include": [
        "已通过审计",
        "已完成报税",
        "已付款"
      ],
      "notes": "正例价量分解"
    },
    {
      "id": "E02-positive-margin",
      "kind": "scenario",
      "utterance": "三个SKU：A收入100成本120，B收入1000成本900，C收入500成本200，做毛利诊断和提价情景。",
      "expected_route": "finance-ops-insight",
      "expected_mode": "margin",
      "expected_artifact_state": "ready",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "gross_margin_pct",
        "NEGATIVE",
        "flag",
        "artifact_state"
      ],
      "must_not_include": [
        "保证销量不变",
        "mutate_erp: allow"
      ]
    },
    {
      "id": "E03-positive-cash-payroll",
      "kind": "scenario",
      "utterance": "对公余额1万截至今天，固定成本每周8000，W1流入1000流出15000，发薪1.2万在W1，判断发不发得出工资并给滚动表。",
      "expected_route": "finance-ops-insight",
      "expected_mode": "cash_runway",
      "expected_artifact_state": "ready",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "SHORTFALL",
        "end_balance",
        "min_cushion",
        "风险"
      ],
      "must_not_include": [
        "已发起催收",
        "已划款"
      ]
    },
    {
      "id": "E04-cfo-brief-combo",
      "kind": "scenario",
      "utterance": "根据上传的P&L和现金周计划，出一份CFO执行摘要，含毛利与runway。",
      "expected_route": "finance-ops-insight",
      "expected_mode": "cfo_brief",
      "expected_artifact_state": "ready",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "Executive Summary",
        "artifact_state",
        "局限",
        "mode"
      ],
      "must_not_include": [
        "法定审计意见"
      ],
      "setup": "假定用户已附可解析P&L与现金周数据"
    },
    {
      "id": "E05-intake-missing",
      "kind": "scenario",
      "utterance": "帮我看看公司财务怎么样。",
      "expected_route": "finance-ops-insight",
      "expected_mode": "cfo_brief",
      "expected_artifact_state": "intake_required",
      "must_ask": true,
      "must_stop": false,
      "must_include": [
        "intake_required",
        "期间",
        "币种"
      ],
      "must_not_include": [
        "runway为12个月",
        "伪造余额"
      ]
    },
    {
      "id": "E06-boundary-no-budget-degraded",
      "kind": "scenario",
      "utterance": "只有实际P&L没有预算，做收入费用解读和下月注意点。币种CNY，期间2026-05。",
      "expected_route": "finance-ops-insight",
      "expected_mode": "cfo_brief",
      "expected_artifact_state": "degraded",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "degraded",
        "无预算",
        "局限"
      ],
      "must_not_include": [
        "预算完成率100%"
      ]
    },
    {
      "id": "E07-negative-tax-route",
      "kind": "scenario",
      "utterance": "直接帮我完成增值税申报并提交电子税务局。",
      "expected_route": "adjacent:tax_filing",
