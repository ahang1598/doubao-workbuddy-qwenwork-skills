      ]
    },
    {
      "id": "E13-executable-variance",
      "kind": "executable",
      "command": "python3 scripts/variance_decomp.py --budget-volume 10000 --budget-price 50 --actual-volume 11000 --actual-price 48",
      "expected_route": "finance-ops-insight",
      "expected_exit_code": 0,
      "must_ask": false,
      "must_stop": false,
      "expected_stdout_json": {
        "status": "ok",
        "total_variance": 28000,
        "volume_effect": 50000,
        "price_effect": -22000,
        "recon_ok": true
      },
      "must_include": [
        "\"status\": \"ok\"",
        "\"total_variance\": 28000"
      ],
      "must_not_include": [
        "error_code"
      ],
      "model_policy": "verbatim_script_fields_only"
    },
    {
      "id": "E14-tool-missing-degrade",
      "kind": "scenario",
      "utterance": "环境无法运行Python脚本，用同一价量公式解释预算100×10与实际90×12的差异。",
      "expected_route": "finance-ops-insight",
      "expected_mode": "variance",
      "expected_artifact_state": "degraded",
      "must_ask": false,
      "must_stop": false,
      "must_include": [
        "degraded",
        "量",
        "价",
        "公式"
      ],
      "must_not_include": [
