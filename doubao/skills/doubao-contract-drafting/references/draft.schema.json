{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/doubao-contract-drafting/v5.6/draft.schema.json",
  "title": "doubao Contract Draft V5.7",
  "type": "object",
  "required": [
    "title",
    "placeholder",
    "use_comments",
    "use_colors",
    "allow_tables",
    "contract_form",
    "signature_ready",
    "facts",
    "sections",
    "appendices",
    "signature"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "placeholder": {"const": ""},
    "use_comments": {"const": false},
    "use_colors": {"const": false},
    "allow_tables": {"type": "boolean"},
    "contract_form": {"enum": ["single", "framework"]},
    "parameter_profile": {
      "type": "object",
      "required": ["family", "role", "required"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "required": {"type": "array", "items": {"type": "string"}},
        "not_applicable": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "signature_ready": {"type": "boolean"},
    "has_blanks": {"type": "boolean"},
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    },
    "appendices": {
      "type": "array",
      "items": {"$ref": "#/$defs/appendix"}
    },
    "signature": {"type": "array", "items": {"type": "string"}},
    "tables": {"$ref": "#/$defs/tables"},
    "delivery_summary": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"contract_form": {"const": "single"}}},
      "then": {
        "required": ["parameter_profile"],
        "properties": {"signature": {"minItems": 1}}
      }
    }
  ],
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "fact": {
      "type": "object",
      "required": ["key", "value", "status"],
      "properties": {
        "key": {"type": "string"},
        "value": {},
        "source": {"type": "string"},
        "status": {
          "enum": ["confirmed", "derived", "standard_term", "standard_parameter", "pending", "disputed"]
        },
        "basis": {"type": "string"},
        "coverage_terms": {"$ref": "#/$defs/nonEmptyStrings"},
        "aliases": {"$ref": "#/$defs/nonEmptyStrings"},
        "forbidden_assertions": {"$ref": "#/$defs/nonEmptyStrings"},
        "contract_slot": {"type": "string"},
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "standard_parameter"}}, "required": ["status"]},
          "then": {"required": ["basis", "coverage_terms"]}
        },
        {
          "if": {"properties": {"status": {"const": "pending"}}, "required": ["status"]},
          "then": {"required": ["aliases", "forbidden_assertions"]}
        }
      ],
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": ["level", "text"],
      "properties": {
        "level": {"enum": [1, 2]},
        "text": {"type": "string"}
      },
      "additionalProperties": true
    },
    "row": {
      "type": "array",
      "minItems": 1,
      "items": {}
    },
    "table": {
      "type": "array",
      "items": {"$ref": "#/$defs/row"}
    },
    "tables": {
      "type": "array",
      "items": {"$ref": "#/$defs/table"}
    },
    "appendix": {
      "type": "object",
      "required": ["number", "title"],
      "properties": {
        "number": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string"},
        "content": {"type": "array", "items": {"type": "string"}},
        "tables": {"$ref": "#/$defs/tables"},
        "list_only": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
