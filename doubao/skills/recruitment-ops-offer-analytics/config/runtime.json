{
  "skill_id": "recruitment-ops-offer-analytics",
  "version": "V2-search-autonomy",
  "contract_version": "V3.3",
  "production_id": "PROD-041",
  "core_skill_id": "CORE-046",
  "archetype": "workflow-operations",
  "case_type": "hr_recruiting",
  "category": "人力招聘",
  "primary_artifact": "recruitment_ops_decision_pack",
  "default_mode": "pipeline_track",
  "default_delivery_tier": "direct",
  "delivery_tiers": {
    "direct": {
      "target_chars": 1800,
      "target_output_tokens": 1200,
      "hard_max_output_tokens": 1600,
      "required_slots": [
        "answer",
        "permission_state",
        "evidence",
        "next_action"
      ]
    },
    "brief": {
      "target_chars": 5000,
      "target_output_tokens": 3300,
      "hard_max_output_tokens": 4200,
      "required_slots": [
        "frozen_scope",
        "capabilities",
        "core_result",
        "unknowns",
        "next_actions"
      ]
    },
    "full": {
      "target_chars": 9000,
      "target_output_tokens": 6000,
      "hard_max_output_tokens": 7000,
      "required_slots": [
        "frozen_scope",
        "capabilities",
        "claim_ledger",
        "pipeline_or_offer",
        "confirmations",
        "limitations",
        "artifact_index"
      ]
    }
  },
  "provider_safety_ceiling": {
    "max_output_tokens": 7500,
    "hard_max_output_tokens": 7500,
    "on_risk": "degrade_to_minimum_complete_artifact"
  },
  "route_contract": {
    "fields": [
      "selected_skill",
      "intent",
      "route_status"
    ],
    "route_only_forbids_business_analysis": true
  },
  "capability_gates": {
    "slots": [
      "can_read_pipeline",
      "can_compute_recruiting_metrics",
      "can_draft_offer",
      "can_request_offer_approval",
      "can_send_offer",
      "can_record_acceptance",
      "can_handoff_onboarding"
    ],
    "states": [
      "allowed",
      "missing",
      "blocked"
    ],
    "partial_delivery_required": true
  },
  "artifact_states": [
    "ready",
    "degraded",
    "intake_required",
    "confirmation_required",
    "routed",
    "stopped"
  ],
  "modes": [
    "recruiting_policy",
    "pipeline_track",
    "offer_lifecycle",
    "pre_accept_warming",
    "recruiting_metrics",
    "accepted_handoff"
  ],
  "intake": {
    "blocking": [
      "intent_mode",
      "scope_anchor"
    ],
    "optional": [
      "org_scope",
      "campus_year",
      "req_or_hc_id",
      "channel",
      "baseline_period",
      "pii_preference",
      "allow_outbound_draft"
    ],
    "max_clarifying_questions": 3
  },
  "permissions": {
    "read": "allow_with_degrade",
    "write": "confirm_auth_idempotent_audit",
    "send": "confirm_auth_idempotent_audit",
    "delete": "deny_by_default_double_confirm",
    "pay": "deny",
    "deploy": "deny"
  },
  "idempotency": {
    "required_for": [
      "write",
      "send"
    ],
    "key_formula": "hash(mode+scope+action+payload_version)"
  },
  "output_budget": {
    "max_chars": 12000,
    "compression_priority": [
      "hard_gates",
      "executive_summary",
      "actions_confirmations",
      "pipeline_or_metrics_tables",
      "sop_warming_summary",
      "appendix"
    ]
  },
  "routing": {
    "adjacent": {
      "interview_execution": "interview-execution-and-review",
      "resume_search": "talent-sourcing-and-shortlist",
      "job_design": "job-modeling-and-selection-design",
      "compensation": "unavailable_handoff_only",
      "accepted_onboarding": "unavailable_handoff_only",
      "performance": "unavailable_handoff_only",
      "organization_planning": "unavailable_handoff_only",
      "recruiting_policy": "recruitment-ops-offer-analytics",
      "employment_law_or_compliance": "enterprise-compliance-review",
      "people_analytics_decision": "decision-analysis-report",
      "people_analytics_anomaly": "metric-anomaly-diagnostics",
      "people_analytics_metric_design": "kpi-measurement-design",
      "schedule_automation": "schedule-automation"
    }
  },
  "safety": {
    "lawyer_opinion": false,
    "illegal_background_check": false,
    "prompt_injection_untrusted_external": true,
    "pii_default_mask": true,
    "protected_attribute_inference": "forbidden",
    "fixed_third_party_stages_or_thresholds": "forbidden"
  },
  "evidence_policy": {
    "claim_ledger_required": true,
    "unknown_conservation": true,
    "private_inputs_not_searchable": [
      "ats_state",
      "candidate_status",
      "approval",
      "comp_boundary",
      "offer_template",
      "internal_policy"
    ],
    "official_or_authorized_source_required_for": [
      "offer_terms",
      "approval_state",
      "acceptance_state",
      "company_policy"
    ]
  },
  "deterministic_tool": "scripts/recruitment_ops_tool.py",
  "deterministic_tool_modes": ["pipeline_conservation", "conversion", "velocity", "offer_field_check", "offer_capability_gate", "privacy_gate"],
  "tool_contract": {
    "full_output": "recruitment_ops_ledger",
    "schema_version": "hr-recruitment-tool/1.0",
    "hash": "sha256_canonical_full_json",
    "compact_output": [
      "counts",
      "unknowns",
      "hard_gates",
      "source_index",
      "artifact_path"
    ]
  },
  "compact_tool_output": true,
  "expected_artifacts": [
    "recruitment_ops_decision_pack",
    "claim_ledger",
    "accepted_handoff"
  ],
  "deliverable_validator": "runtime/validate_deliverable.py",
  "finalizer": {
    "mode": "source_locked",
    "may_search": false,
    "max_runs": 1
  },
  "privacy_scan": {
    "enabled": true,
    "protected_attributes": "reject",
    "candidate_pii": "minimize"
  },
  "success_contract": {
    "success": "recruiting_ops_or_offer_pack",
    "degraded": "minimum_complete_artifact",
    "stop": "unsafe_or_unroutable"
  },
  "loading_profile": {
    "root_first": true,
    "max_reference_depth": 1,
    "preload_evals": false
  },
  "degrade_policies": [
    "missing_datasource",
    "permission_denied",
    "campus_not_in_warehouse",
    "metric_definition_ambiguous",
    "partial_user_paste_only"
  ],
  "search_runtime": {
    "router": "runtime/search_router.py",
    "evidence_validator": "runtime/search_evidence_validator.py",
    "deliverable_validator": "runtime/validate_deliverable.py",
    "route_default": "off",
    "max_calls": 0,
    "optional_max_calls": 0,
    "source_order": [
      "user_material",
      "authorized_private_data",
      "official_primary"
    ],
    "query_stages": [],
    "primary_source_types": [
      "user_material",
      "authorized_private_data"
    ],
    "critical_claim_policy": {
      "require_primary_or_official": true,
      "critical_claims": "招聘专属政策 | pipeline当前态与卡点 | Offer条款与审批发送状态 | Accepted交接 | 实时招聘运营指标",
      "unsupported_action": "unknown",
      "conflict_action": "disclose_or_unknown"
    },
    "deliverable_contract": {
      "required_any": [
        [
          "结论",
          "交付"
        ],
        [
          "局限",
          "风险",
          "免责声明"
        ]
      ],
      "min_urls": 0,
      "min_chars": 80,
      "forbidden_patterns": [
        "DETERMINISTIC TOOL OUTPUT",
        "search-evidence\\.json"
      ],
      "repair_policy": "deterministic_only_no_new_facts"
    },
    "decision_policy": {
      "version": "task-semantic-v1",
      "principle": "先判断核心交付是否依赖外部公共证据，不要求用户声明是否联网",
      "core_deliverable": "可溯源政策与准入说明 | 流程进度与卡点预警 | Offer入职试用SOP | 保温方案话术与回写结果 | 指标结果与归因解读",
      "required_when": [],
      "optional_when": [
        "若任务实为公开劳动法规核验，应路由合规 Skill"
      ],
      "off_when": [
        "处理内部政策、pipeline、Offer SOP、保温与招聘指标"
      ],
      "blocked_when": [
        "搜索候选隐私、违法背调或未授权 HR 数据"
      ],
      "required_max_calls": 3,
      "optional_max_calls": 2,
      "clarify_when_material": [
        "object",
        "scope",
        "time"
      ],
      "route_default_rationale": "该 Skill 的权威源是内部政策和招聘系统，Web Search 默认不适用。",
      "audit_schema_version": "1.0"
    }
  }
}
