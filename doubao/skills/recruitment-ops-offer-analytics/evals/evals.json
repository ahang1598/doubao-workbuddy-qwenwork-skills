{
  "skill_id": "recruitment-ops-offer-analytics",
  "version": "V3.3",
  "evals": [
    {
      "id": "E01_policy_positive",
      "kind": "scenario",
      "utterance": "社招活水调入的offer审批和冷却期政策是什么？我是正式员工跨BG活水。",
      "expected_route": "recruiting_policy",
      "expected_artifact_state": "ready",
      "must_ask": false,
      "must_stop": false,
      "must_include": ["recruitment_ops_decision_pack", "not_legal_advice", "executive_summary", "applicability"],
      "must_not_include": ["保证胜诉", "律师意见书", "已完成背调"],
      "checks": {
        "mode": "recruiting_policy",
        "permission_state": "read_only",
        "complete_closing": true
      }
    },
    {
      "id": "E02_pipeline_positive",
      "kind": "scenario",
      "utterance": "看下我负责的后端岗位里offer已发但超过7天未接受的人，帮我标卡点。",
      "expected_route": "pipeline_track",
      "expected_artifact_state": "degraded",
      "must_ask": false,
      "must_stop": false,
      "must_include": ["blockers", "alerts", "artifact_state", "pipeline_or_list"],
      "must_not_include": ["已批量发送催促且无需确认"],
      "checks": {
        "mode": "pipeline_track",
        "structure": ["items", "blockers", "actions"],
        "complete_closing": true
      }
    },
    {
      "id": "E03_sop_positive",
