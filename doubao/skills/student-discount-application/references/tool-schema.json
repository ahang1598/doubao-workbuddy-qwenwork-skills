                "description": "BENEFIT_GRANTED 和 BENEFIT_ALREADY_GRANTED 返回权益信息；其他状态为 null。"
              }
            },
            "required": [
              "schemaVersion",
              "statusCode",
              "requiredUserAction",
              "nextCheckAfterSec",
              "quickReplies",
              "bindingActionExpiresAt",
              "hasStudentAuthQrCode",
              "qrCodeExpiresAt",
              "benefit"
            ]
          },
          {
            "type": "null"
          }
        ],
        "description": "成功时为稳定的业务状态对象；工具执行错误时为 null。"
      }
    },
    "required": [
      "errorCode",
      "errorType",
      "errorMsg",
      "errorStage",
      "paramPath",
      "retryable",
      "retryAfterSec",
      "suggestedFix",
      "instance",
      "safeToShowUser",
      "studentDiscountData"
    ]
  },
  "annotations": {
    "readOnlyHint": false,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  }
