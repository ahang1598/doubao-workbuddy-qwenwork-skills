{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lawd-estate-planning/case.schema.json",
  "title": "Will and estate planning case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_id",
    "status",
    "baseline_at",
    "audience_profile",
    "intake_session",
    "subject",
    "testator_basic_info",
    "testator_capacity",
    "will_execution_plan",
    "reserved_share_review",
    "inheritance_review",
    "people",
    "relationships",
    "assets",
    "liabilities",
    "existing_documents",
    "intentions",
    "evidence",
    "issues",
    "confirmations",
    "consent",
    "legal_research",
    "rule_context",
    "will_document",
    "deliverables",
    "output_preferences"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "date_time_or_null": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "enum": [
            "user_statement",
            "uploaded_document",
            "professional_input",
            "system_derived",
            "external_source"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "confidence",
        "confirmation_status",
        "confirmed_at"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confirmation_status": {
          "enum": [
            "pending_confirmation",
            "confirmed",
            "disputed",
            "unknown",
            "not_applicable"
          ]
        },
        "confirmed_at": {
          "$ref": "#/$defs/date_time_or_null"
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "roles",
        "birth_year",
        "contact_masked",
        "notes",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "birth_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1800,
          "maximum": 2200
        },
        "contact_masked": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from_person_id",
        "to_person_id",
        "relationship_type",
        "status",
        "notes",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from_person_id": {
          "$ref": "#/$defs/id"
        },
        "to_person_id": {
          "$ref": "#/$defs/id"
        },
        "relationship_type": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id",
        "share_percent"
      ],
      "properties": {
        "person_id": {
          "$ref": "#/$defs/id"
        },
        "share_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "asset_type",
        "description",
        "location",
        "estimated_value",
        "currency",
        "owners",
        "evidence_status",
        "arrangement_status",
        "notes",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset_type": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimated_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "owners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/owner"
          }
        },
        "evidence_status": {
          "enum": [
            "missing",
            "uploaded",
            "verified",
            "not_applicable"
          ]
        },
        "arrangement_status": {
          "enum": [
            "not_started",
            "partial",
            "covered",
            "unknown"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "liability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "liability_type",
        "description",
        "creditor_masked",
        "amount",
        "currency",
        "related_asset_ids",
        "status",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "liability_type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "creditor_masked": {
          "type": [
            "string",
            "null"
          ]
        },
        "amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "related_asset_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "status": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "existing_document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "document_type",
        "description",
        "document_date",
        "file_reference",
        "verification_status",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "document_type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "document_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "file_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "enum": [
            "not_reviewed",
            "reviewed",
            "uncertain",
            "missing"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "intention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "intention_type",
        "summary",
        "priority",
        "related_person_ids",
        "related_asset_ids",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "intention_type": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "related_person_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "related_asset_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "evidence_type",
        "description",
        "file_reference",
        "sha256",
        "related_ids",
        "verification_status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "evidence_type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "file_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "related_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "verification_status": {
          "enum": [
            "not_reviewed",
            "parsed",
            "verified",
            "rejected"
          ]
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "level",
        "issue_type",
        "title",
        "description",
        "related_ids",
        "status",
        "next_action",
        "owner"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "enum": [
            "BLOCKED",
            "REVIEW_REQUIRED",
            "WARN",
            "INFO",
            "PASS"
          ]
        },
        "issue_type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "related_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "accepted",
            "not_applicable"
          ]
        },
        "next_action": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "related_ids",
        "confirmed_by",
        "confirmed_at",
        "method"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "enum": [
            "facts",
            "relationships",
            "assets",
            "liabilities",
            "intentions",
            "research",
            "output",
            "other"
          ]
        },
        "related_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "confirmed_by": {
          "$ref": "#/$defs/id"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "card_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "base_card_id",
        "selected_values",
        "free_text",
        "answer_status",
        "answered_at",
        "confirmed"
      ],
      "properties": {
        "card_id": {
          "$ref": "#/$defs/id"
        },
        "base_card_id": {
          "$ref": "#/$defs/id"
        },
        "selected_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "free_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "answer_status": {
          "enum": [
            "answered",
            "unknown",
            "not_applicable",
            "declined",
            "later"
          ]
        },
        "answered_at": {
          "type": "string",
          "format": "date-time"
        },
        "confirmed": {
          "type": "boolean"
        },
        "field_values": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "issuing_body",
        "document_number",
        "effective_status",
        "publication_date",
        "effective_date",
        "source_url",
        "retrieved_at",
        "relevance",
        "limitations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "issuing_body": {
          "type": "string"
        },
        "document_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "effective_status": {
          "enum": [
            "effective",
            "amended_effective",
            "not_yet_effective",
            "repealed",
            "unknown"
          ]
        },
        "publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "effective_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "relevance": {
          "type": "string"
        },
        "limitations": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "case_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "case_number_or_library_id",
        "court_or_publisher",
        "decision_or_publication_date",
        "source_kind",
        "source_url",
        "retrieved_at",
        "relevance",
        "differences"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "case_number_or_library_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "court_or_publisher": {
          "type": "string"
        },
        "decision_or_publication_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "source_kind": {
          "enum": [
            "guiding_case",
            "case_database",
            "spc_typical",
            "gazette_case",
            "judgment_database",
            "court_publication"
          ]
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "relevance": {
          "type": "string"
        },
        "differences": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "education_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publisher",
        "content_type",
        "published_at",
        "url",
        "retrieved_at",
        "verified_access",
        "relevance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "content_type": {
          "enum": [
            "article",
            "video"
          ]
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_access": {
          "type": "boolean"
        },
        "relevance": {
          "type": "string"
        }
      }
    },
    "will_section": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "0.5.1"
    },
    "work_id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "audience_selecting",
        "intake_cards",
        "information_incomplete",
        "user_confirming",
        "researching",
        "research_blocked",
        "research_verified",
        "review_required",
        "ready_for_output",
        "output_generated"
      ]
    },
    "baseline_at": {
      "type": "string",
      "format": "date-time"
    },
    "audience_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience_type",
        "language_profile",
        "selected_via_card_id",
        "selected_at",
        "confirmed"
      ],
      "properties": {
        "audience_type": {
          "enum": [
            "lawyer",
            "general_public"
          ]
        },
        "language_profile": {
          "enum": [
            "professional",
            "plain"
          ]
        },
        "selected_via_card_id": {
          "const": "audience-type"
        },
        "selected_at": {
          "type": "string",
          "format": "date-time"
        },
        "confirmed": {
          "type": "boolean"
        }
      }
    },
    "intake_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deck_id",
        "deck_version",
        "status",
        "navigation_mode",
        "collection_channel",
        "coverage_assessment",
        "required_card_ids",
        "skipped_base_card_ids",
        "progress",
        "current_card_id",
        "card_responses",
        "confirmed_at"
      ],
      "properties": {
        "deck_id": {
          "const": "will-intake-v3"
        },
        "deck_version": {
          "const": "4.0.0"
        },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "awaiting_confirmation",
            "confirmed"
          ]
        },
        "navigation_mode": {
          "const": "mode_routed_batched"
        },
        "coverage_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "assessed_at",
            "source_document_ids",
            "topics"
          ],
          "properties": {
            "status": {
              "enum": [
                "sufficient_for_drafting",
                "cards_required"
              ]
            },
            "assessed_at": {
              "type": "string",
              "format": "date-time"
            },
            "source_document_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              },
              "uniqueItems": true
            },
            "topics": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "sufficient",
                  "partial",
                  "missing",
                  "not_applicable"
                ]
              }
            }
          }
        },
        "required_card_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "skipped_base_card_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "progress": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_questions",
            "completed_questions",
            "current_question_index"
          ],
          "properties": {
            "total_questions": {
              "type": "integer",
              "minimum": 0
            },
            "completed_questions": {
              "type": "integer",
              "minimum": 0
            },
            "current_question_index": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "current_card_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "card_responses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/card_response"
          }
        },
        "confirmed_at": {
          "$ref": "#/$defs/date_time_or_null"
        },
        "collection_channel": {
          "const": "ask_user_question"
        },
        "collection_mode": {
          "enum": [
            "fast",
            "complete",
            "lawyer_sheet"
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_id"
      ],
      "properties": {
        "person_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "testator_basic_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "gender",
        "birth_date",
        "identity_number",
        "address",
        "source_card_id",
        "confirmation_status",
        "confirmed_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "gender": {
          "type": "string",
          "minLength": 1
        },
        "birth_date": {
          "type": "string",
          "format": "date"
        },
        "identity_number": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "source_card_id": {
