{
  "deck_id": "will-intake-v3",
  "version": "4.0.0",
  "title": "遗嘱起草信息采集卡组（千问办公原生版）",
  "platform": "qwenwork",
  "collection_channel": "ask_user_question",
  "composition_mode": "deterministic_coverage",
  "navigation_mode": "mode_routed_batched",
  "forbidden_collection_modes": [
    "chat_question_answer",
    "display_only_widget",
    "download_json",
    "copy_json_to_chat",
    "tell_assistant_completed"
  ],
  "batching": {
    "max_questions_per_call": 4,
    "max_options_per_question": 4,
    "auto_other_for_free_text": true,
    "branch_question_must_end_batch": true,
    "repeatable_page_is_single_call": true,
    "greedy_pack_single_questions": true,
    "progress_label_template": "信息补充：第 {batch_index}/{batch_total} 组（必答信息共 {total_questions} 项，已确认 {completed_questions} 项）",
    "independent_branch_questions_may_share_batch": true,
    "work_data_write_frequency": "per_stage",
    "correction_loop_max": 2
  },
  "preflight": {
    "assess_before_cards": true,
    "mandatory_first_card_id": "privacy-consent",
    "non_skippable_card_ids": [
      "privacy-consent"
    ],
    "inputs": [
      "user_instruction",
      "uploaded_documents"
    ],
    "coverage_values": [
      "sufficient",
      "partial",
      "missing",
      "not_applicable"
    ],
    "skip_when": [
      "sufficient",
      "not_applicable"
    ],
    "model_calls_during_navigation": 0
  },
  "fill_in_policy": {
    "mechanism": "填空一律通过 AskUserQuestion 的选项卡完成：用户选择「其他」直接输入文字，或在题目备注（notes）中补充；禁止改为聊天逐条追问。",
    "with_extracted_value": [
      {
        "label_template": "确认使用：{extracted_value}",
        "maps_to": "extracted"
      },
      {
        "label": "需要更正，请在「其他」中填写，本项勿选",
        "maps_to": "other_input"
      }
    ],
    "without_extracted_value": [
      {
        "label": "请在「其他」中填写，本项勿选",
        "maps_to": "other_input"
      },
      {
        "label": "暂不填写，先以占位符生成框架稿",
        "maps_to": "placeholder"
      }
    ],
    "sensitive_masked_in_option": true,
    "placeholder_field_value": null,
    "placeholder_answer_status": "later",
    "notes_target": "free_text",
    "platform_note": "千问办公的「其他」项由平台固定追加在选项末尾，位置与提示文字均不可自定义；凡需要用户文字填写的选项一律标注（请在「其他」中填写，本项勿选），填写指引写入题干。"
  },
  "cards": [
    {
      "base_card_id": "actor-authority",
      "coverage_key": "actor_authority",
      "kind": "single_question",
      "title": "办理人与授权",
      "ask": {
        "header": "办理人",
        "question": "本次遗嘱事务由谁办理？",
        "multiSelect": false,
        "options": [
          {
            "value": "self",
            "label": "遗嘱人本人",
            "description": "我就是在为自己订立遗嘱的人"
          },
          {
            "value": "authorized_assistant",
            "label": "经授权代办",
            "description": "家人或受托人经遗嘱人授权协助办理"
          }
        ]
      },
      "modes": [
        "complete",
        "fast_targeted"
      ],
      "skip_in_modes": [
        "lawyer_sheet"
      ],
      "category": "入口与收尾"
    },
    {
      "base_card_id": "lawyer-privacy-consent",
      "coverage_key": "lawyer_privacy_consent",
      "kind": "multi_select",
      "category": "入口与收尾",
      "modes": [
        "lawyer_sheet"
      ],
      "title": "律师通道隐私确认",
      "required_selected_values": [
        "accepted",
        "sensitive_data_acknowledged"
      ],
      "ask": {
        "header": "隐私确认",
        "question": "律师通道将处理当事人敏感信息，继续前请确认：本次填写的信息（当事人身份、家庭关系、财产状况、分配意愿及上传文件）仅用于本遗嘱事项的信息整理与成果生成。信息经千问办公平台及AI能力处理，按《千问办公隐私政策》在境内加密存储、按最短必要期限保存、不作商业性公开披露；您可依政策行使查阅、更正、删除、撤回同意等权利（投诉邮箱 dataprivacy@service.dingtalk.com）。您可随时停止填写，并要求删除本次工作目录中的生成文件。证件号码等敏感值展示时掩码；AI生成成果须经律师人工复核。请同时勾选以下两项：",
        "multiSelect": true,
        "options": [
          {
            "value": "accepted",
            "label": "同意仅用于本次办理"
          },
          {
            "value": "sensitive_data_acknowledged",
            "label": "知悉敏感信息处理方式与本人权利"
          }
        ]
      }
    },
    {
      "base_card_id": "testator-basic-info",
      "coverage_key": "testator_basic_info",
      "kind": "fill_in_fields",
      "title": "遗嘱人基本信息",
      "response_mode": "field_values",
      "chat_text_substitute_forbidden": true,
      "packing_note": "5 个字段中前 4 题为一组，第 5 题与下一张卡的问题合并为一组。",
      "fields": [
        {
          "field_id": "name",
          "input": "fill_in",
          "ask": {
            "header": "姓名",
            "question": "立遗嘱的人姓名？"
          }
        },
        {
          "field_id": "identity_number",
          "input": "fill_in",
          "sensitive": true,
          "ask": {
            "header": "证件号码",
            "question": "立遗嘱的人身份证号码？（性别与出生日期会自动推导，不用另外填；展示时掩码）"
          }
        },
        {
          "field_id": "address",
          "input": "fill_in",
          "sensitive": true,
          "ask": {
            "header": "住址",
            "question": "立遗嘱的人常住地址？"
          }
        }
      ],
      "modes": [
        "complete",
        "fast_targeted"
      ],
      "prompt": "请补充遗嘱人的基本信息（已从材料识别的字段无需重复填写）。",
      "category": "人员确认类",
      "derivation_note": "性别与出生日期由身份证号自动推导；用户修改身份证号时联动更新，统一在汇总核对确认。"
    },
    {
      "base_card_id": "testator-capacity",
      "coverage_key": "testator_capacity_and_intent",
      "kind": "structured_fields",
      "title": "理解、表达与真实意愿",
      "response_mode": "field_values",
      "fields": [
        {
          "field_id": "reported_status",
          "input": "fixed_options",
          "ask": {
            "header": "理解与表达",
            "question_self": "您目前是否能清楚理解本次安排的含义，并顺畅表达自己的想法？",
            "question_reporter": "据您观察，遗嘱人是否能清楚理解本次安排的含义，并顺畅表达自己的想法？",
            "options": [
              {
                "value": "no_concern_reported",
                "label": "能，理解和表达都很清楚"
              },
              {
                "value": "communication_support_needed",
                "label": "有些吃力，需要辅助"
              },
              {
                "value": "concern_reported",
                "label": "存在明显困难或疑点"
              },
              {
                "value": "unknown",
                "label": "不确定"
              }
            ]
          }
        },
        {
          "field_id": "voluntariness_status",
          "input": "fixed_options",
          "ask": {
            "header": "真实自愿",
            "question_self": "接下来的各项安排是否都出自您真实、自愿的意愿，没有受到干扰或压力？",
            "question_reporter": "据您观察，遗嘱人的各项安排是否出自其真实、自愿的意愿，没有受到干扰或压力？",
            "options": [
              {
                "value": "no_concern_reported",
                "label": "是，完全自愿"
              },
              {
                "value": "concern_reported",
                "label": "存在干扰或压力的疑虑"
              },
              {
                "value": "unknown",
                "label": "不确定"
              }
            ]
          }
        },
        {
          "field_id": "observations",
          "input": "fixed_options",
          "ask": {
            "header": "补充说明",
            "question": "还有需要补充说明的情况或可提供的材料吗？",
            "options": [
              {
                "value": "none",
                "label": "暂无补充"
              },
              {
                "value": "has_notes",
                "label": "有补充（请在「其他」中填写，本项勿选）"
              }
            ]
          }
        }
      ],
      "modes": [
        "complete",
        "fast_targeted"
      ],
      "perspective": {
        "self": "办理人为遗嘱人本人时，本卡紧跟办理人确认之后作为第 1、2 题出现，使用本人口吻",
        "reporter": "经授权代办或律师通道时，在补采阶段出现，使用转述口吻"
      },
      "category": "人员确认类"
    },
    {
      "base_card_id": "family-map",
      "coverage_key": "heirs_and_relationships",
      "kind": "repeatable_pages",
      "title": "继承人与重要关系人",
      "count_question": {
        "header": "关系人数量",
        "question": "希望把财产分配给几位重要关系人？",
        "options": [
          {
            "value": "1",
            "label": "1 位"
          },
          {
            "value": "2",
            "label": "2 位"
          },
          {
            "value": "3",
            "label": "3 位"
          },
          {
            "value": "4+",
            "label": "4 位及以上（录满 4 位后再确认是否继续）"
          }
        ]
      },
      "instance_id_template": "family-map-person-{n}",
      "page": {
        "title_template": "关系人 {n}",
        "questions": [
          {
            "field_id": "relationship",
            "input": "fixed_options",
            "ask": {
              "header": "关系",
              "question": "关系人与遗嘱人的关系是什么？（其他关系，例如未经登记的伴侣、重要朋友等，请在「其他」中填写）",
              "options": [
                {
                  "value": "spouse",
                  "label": "配偶"
                },
                {
                  "value": "father",
                  "label": "父亲"
                },
                {
                  "value": "mother",
                  "label": "母亲"
                },
                {
                  "value": "child",
                  "label": "子女（可在备注注明儿子/女儿等）"
                }
              ]
            }
          },
          {
            "field_id": "name",
            "input": "fill_in",
            "ask": {
              "header": "姓名",
              "question": "该关系人的姓名？"
            }
          },
          {
            "field_id": "identity_number",
            "input": "fill_in",
            "sensitive": true,
            "ask": {
              "header": "证件号码",
              "question": "该关系人身份证号码？（可留空；性别与出生日期自动推导，展示时掩码）"
            }
          },
          {
            "field_id": "is_possible_heir",
            "input": "fixed_options",
            "ask": {
              "header": "法定继承人",
              "question": "该关系人是否属于已知或可能的法定继承人？法定继承人包括第一顺位的配偶、子女、父母，以及第二顺位的兄弟姐妹、祖父母、外祖父母。其中，子女包括婚生子女、非婚生子女、养子女和有扶养关系的继子女；父母包括生父母、养父母和有扶养关系的继父母；兄弟姐妹包括同父母的兄弟姐妹、同父异母或者同母异父的兄弟姐妹、养兄弟姐妹、有扶养关系的继兄弟姐妹。",
              "options": [
                {
                  "value": "yes",
                  "label": "是"
                },
                {
                  "value": "no",
                  "label": "否"
                },
                {
                  "value": "unknown",
                  "label": "不确定"
                }
              ]
            }
          }
        ]
      },
      "modes": [
        "complete",
        "fast_targeted"
      ],
      "category": "人员确认类",
      "trailing_questions": [
        {
          "field_id": "other_statutory_heirs",
          "input": "fixed_options",
          "ask": {
            "header": "其他继承人",
            "question": "除已填写的关系人外，是否还有其他法定继承人，或者可能缺乏劳动能力又没有生活来源的人（如年迈父母、未成年子女），以及胎儿？（法律要求为这类人保留必要份额，需一并考虑）",
            "options": [
              {
                "value": "none",
                "label": "没有"
              },
              {
                "value": "reported",
                "label": "有（请在「其他」中填写，本项勿选）"
              },
              {
                "value": "unknown",
                "label": "不确定"
              }
            ]
          }
        },
        {
          "field_id": "fetal_share_treatment",
          "input": "fixed_options",
          "ask": {
            "header": "胎儿份额",
            "question": "本次安排是否可能涉及应当为胎儿保留的继承份额？",
            "options": [
              {
                "value": "not_applicable",
                "label": "不涉及"
              },
              {
                "value": "reserved",
                "label": "已明确保留"
              },
              {
                "value": "not_addressed",
                "label": "可能涉及但未处理"
              },
              {
                "value": "unknown",
                "label": "不确定"
              }
            ]
          }
        },
        {
          "field_id": "disqualification_status",
          "input": "fixed_options",
          "ask": {
            "header": "继承权异常",
            "question": "是否存在继承人因故意杀害被继承人、遗弃或严重虐待等行为而可能丧失继承权的情形？",
            "options": [
              {
                "value": "none",
                "label": "不存在"
              },
              {
                "value": "reported",
                "label": "存在（请在「其他」中填写，本项勿选）"
              },
              {
                "value": "unknown",
                "label": "不确定"
              }
            ]
          }
        }
      ],
      "derivation_note": "性别与出生日期由身份证号自动推导；'是否法定继承人'由用户逐人确认，快速模式解析时按关系推导。"
    },
    {
      "base_card_id": "guardianship-special",
      "coverage_key": "special_factors",
      "kind": "multi_select",
      "title": "监护与特殊情况",
      "ask": {
        "header": "特殊情况",
        "question": "是否涉及以下特殊情况？（多选；没有上述情况、不确定或其他情况，请选「其他」说明）",
        "multiSelect": true,
        "options": [
          {
            "value": "minor_children",
            "label": "涉及未成年人子女"
          },
          {
            "value": "guardianship",
            "label": "涉及监护安排"
          },
          {
            "value": "overseas",
            "label": "涉及境外财产或境外关系人"
          },
          {
            "value": "family_dispute",
            "label": "存在家庭争议"
          }
        ],
        "other_value_parsing": [
          "other",
          "none",
          "unknown"
        ],
        "exclusivity_note": "「其他」中填写“无”时映射为 none，且不得与其他选项并存。"
      },
      "modes": [
        "complete",
        "fast_targeted"
      ],
      "category": "人员确认类"
    },
    {
      "base_card_id": "asset-declaration",
      "coverage_key": "assets",
      "kind": "repeatable_pages",
      "category": "财产确认类",
      "modes": [
        "complete",
        "fast_targeted"
      ],
      "title": "财产申报",
      "scope_question": {
        "header": "财产类型",
        "question": "需要处分哪些类型的财产？（可多选；如有股权或合伙份额、股票、保险相关权利、债权、其他类型或「无/不确定」请选「其他」填写）",
        "multiSelect": true,
        "options": [
          {
            "value": "financial_assets",
            "label": "存款或其他理财"
          },
          {
            "value": "real_estate",
            "label": "房产"
          },
          {
            "value": "digital_assets",
            "label": "数字资产（例如高价值社交账号、游戏账号、游戏内道具（皮肤、装备、游戏币）、平台会员权益、数字货币等）"
          }
        ],
        "other_value_parsing": [
          "equity",
          "stocks",
          "insurance_rights",
          "claims",
          "other",
          "none",
          "unknown"
        ],
        "note": "股权/合伙份额、股票、保险相关权利、债权等经「其他」申报的，逐项进入财产明细页填写。"
      },
      "count_question": {
        "header": "财产数量",
        "question": "共有几项财产需要填写？",
        "options": [
          {
            "value": "1",
            "label": "1 项"
          },
          {
            "value": "2",
            "label": "2 项"
          },
          {
            "value": "3",
            "label": "3 项"
          },
          {
            "value": "4+",
            "label": "4 项及以上（录满后再确认）"
          }
        ]
      },
      "instance_id_template": "asset-declaration-{n}",
      "page": {
        "title_template": "财产 {n}",
        "questions": [
          {
            "field_id": "description",
            "input": "fill_in",
            "ask": {
              "header": "财产描述",
              "question": "请填写这项财产的关键识别信息：房产写到权证记载的坐落地址，存款写到银行与账号，股权写到公司名称与比例，数字资产写到平台与账号。描述应清晰、明确、可特定。"
            }
          },
          {
            "field_id": "ownership",
            "input": "fixed_options",
            "ask": {
              "header": "权属与份额",
              "question": "这项财产登记在谁名下？立遗嘱的人占多少份额？（共有情况容易遗漏，请特别留意）",
              "options": [
                {
                  "value": "sole",
                  "label": "立遗嘱的人单独所有"
                },
                {
                  "value": "spouse_coowned",
                  "label": "与配偶共有"
                },
                {
                  "value": "other_coowned",
                  "label": "与其他人共有（请在「其他」中填写，本项勿选）"
                },
                {
                  "value": "uncertain",
                  "label": "权属不确定"
                }
              ]
            }
          },
          {
            "field_id": "mortgage_or_debt",
            "input": "fixed_options",
            "ask": {
              "header": "抵押负担",
              "question": "这项财产上还有没有抵押、贷款或其他负担？",
              "options": [
                {
                  "value": "none",
                  "label": "无"
                },
                {
                  "value": "yes",
                  "label": "有（请在「其他」中填写，本项勿选）"
                },
                {
                  "value": "unknown",
                  "label": "不确定"
                }
              ]
            }
          }
        ]
      },
      "derivation_note": "财产类型由范围题先行选择或由描述文字自动推导（_asset_type），填写关键识别信息后不再重复选择。"
    },
    {
      "base_card_id": "liability-scope",
      "coverage_key": "liabilities",
      "kind": "gate_then_detail",
      "title": "债务与其他义务",
      "gate": {
        "header": "债务情况",
        "question": "是否还有没还清的债务、为他人提供的担保，或其他持续要承担的义务？",
        "options": [
          {
            "value": "none_known",
            "label": "没有已知债务"
          },
          {
            "value": "mortgage_only",
            "label": "仅有房贷等财产抵押"
          },
          {
            "value": "other_debts",
            "label": "有其他债务或担保"
          },
          {
            "value": "unknown",
            "label": "不确定"
          }
        ]
      },
      "detail_when": [
        "mortgage_only",
        "other_debts"
      ],
      "detail": {
        "questions": [
          {
            "field_id": "summary",
            "input": "fill_in",
