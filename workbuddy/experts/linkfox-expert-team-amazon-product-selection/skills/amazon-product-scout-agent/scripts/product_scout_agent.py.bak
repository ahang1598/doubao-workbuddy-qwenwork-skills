_EU_DIMS = [("SL","小号信封"),("NL","标准信封"),("LL","大号信封"),("ELL","超大号信封"),
            ("SM","小包裹"),("SD","标准包裹"),("SB","小号大件"),("NB","标准大件"),
            ("LB","大号大件"),("SPO","特殊大件"),("O","其他")]
