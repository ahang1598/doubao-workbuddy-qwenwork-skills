    "splitter": "scripts/split_ocr_input.py"
  },
  "files": [
    "SKILL.md",
    "references/ocr-api-integration.md",
    "references/output-contract.md",
    "scripts/ocr_to_markdown.py",
    "scripts/parse_contract_file.py",
    "scripts/split_ocr_input.py",
    "scripts/requirements.txt",
    "meta/manifest.json"
  ]
}
